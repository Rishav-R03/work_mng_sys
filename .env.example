# Copy to .env for local development.

# SQLite locally; on Render use your Neon connection string (postgresql://...?sslmode=require)
DATABASE_URL=sqlite:///./worktracker.db

# Long random string. Signs session cookies and encrypts your GitHub token at rest.
SECRET_KEY=change-me

# Public URL of the app (used for the OAuth callback). No trailing slash.
BASE_URL=http://localhost:8000

# GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL = BASE_URL + /auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only this GitHub login may sign in (keeps the app single-user). Strongly recommended.
ALLOWED_GITHUB_LOGIN=

# "repo" lets the sync see commits in your private repos. Use "read:user" for public only.
GITHUB_SCOPE=read:user repo

# Local testing only: enables /dev-login (demo user, no GitHub needed). Never set on Render.
DEV_LOGIN=0
